# Use OpenJDK as base image
FROM openjdk:17-jdk-slim

# Set working directory
WORKDIR /app/

# Copy JAR file into container
COPY target/ProductDetailService-0.0.1-SNAPSHOT.jar ProductDetailService-0.0.1-SNAPSHOT.jar

# Expose application port
EXPOSE 8087

# Command to run the application
ENTRYPOINT ["java", "-jar", "ProductDetailService-0.0.1-SNAPSHOT.jar"]


RUN mkdir -p /logs

# Define volume for logs (needed for ELK)
VOLUME [ "/logs" ]


# Set environment variables
ENV LOGGING_FILE_NAME=/logs/zion.log
